#: src/ashyterm/ui/ssh_dialogs.py:145
msgid "DNS Resolution Failed"
msgstr "Falha na Resolução de DNS"

#: src/ashyterm/ui/ssh_dialogs.py:136
msgid "Could not resolve the hostname. Check if the address is correct."
msgstr ""
"Não foi possível resolver o nome do host. Verifique se o endereço está "
"correto."

#: src/ashyterm/ui/ssh_dialogs.py:141
msgid "The hostname could not be resolved. Check the server address."
msgstr ""
"O nome do host não pôde ser resolvido. Verifique o endereço do servidor."

#: src/ashyterm/ui/ssh_dialogs.py:146
msgid "No address found for the hostname."
msgstr "Nenhum endereço encontrado para o nome do host."

#: src/ashyterm/ui/ssh_dialogs.py:150
msgid "DNS Temporary Failure"
msgstr "Falha Temporária no DNS"

#: src/ashyterm/ui/ssh_dialogs.py:151
msgid "DNS resolution temporarily failed. Check your network connection."
msgstr ""
"A resolução de DNS falhou temporariamente. Verifique sua conexão de rede."

#: src/ashyterm/ui/ssh_dialogs.py:156
msgid "Connection Refused"
msgstr "Conexão recusada"

#: src/ashyterm/ui/ssh_dialogs.py:157
msgid ""
"The server refused the connection. Check if SSH is running on the server."
msgstr ""
"O servidor recusou a conexão. Verifique se o SSH está em execução no "
"servidor."

#: src/ashyterm/ui/ssh_dialogs.py:161 src/ashyterm/ui/ssh_dialogs.py:168
msgid "Connection Timeout"
msgstr "Tempo de Conexão Esgotado"

#: src/ashyterm/ui/ssh_dialogs.py:163
msgid ""
"Connection attempt timed out. The server may be unreachable or behind a "
"firewall."
msgstr ""
"A tentativa de conexão expirou. O servidor pode estar inacessível ou atrás "
"de um firewall."

#: src/ashyterm/ui/ssh_dialogs.py:169
msgid "The operation timed out. Server may be slow or unreachable."
msgstr ""
"A operação excedeu o tempo limite. O servidor pode estar lento ou "
"inacessível."

#: src/ashyterm/ui/ssh_dialogs.py:173
msgid "No Route to Host"
msgstr "Sem Rota para o Host"

#: src/ashyterm/ui/ssh_dialogs.py:175
msgid ""
"Network path to the server could not be found. Check your network "
"connection."
msgstr ""
"Caminho de rede para o servidor não pôde ser encontrado. Verifique sua "
"conexão de rede."

#: src/ashyterm/ui/ssh_dialogs.py:180 src/ashyterm/ui/ssh_dialogs.py:185
msgid "Network Unreachable"
msgstr "Rede Inacessível"

#: src/ashyterm/ui/ssh_dialogs.py:181 src/ashyterm/ui/ssh_dialogs.py:186
msgid "The network is not reachable. Check your internet connection."
msgstr "A rede não está acessível. Verifique sua conexão com a internet."

#: src/ashyterm/ui/ssh_dialogs.py:191
msgid "Connection Reset"
msgstr "Conexão Reiniciada"

#: src/ashyterm/ui/ssh_dialogs.py:192
msgid "The connection was reset by the remote server."
msgstr "A conexão foi redefinida pelo servidor remoto."

#: src/ashyterm/ui/ssh_dialogs.py:196 src/ashyterm/ui/ssh_dialogs.py:206
msgid "Connection Closed"
msgstr "Conexão Fechada"

#: src/ashyterm/ui/ssh_dialogs.py:197
msgid "The remote server closed the connection unexpectedly."
msgstr "O servidor remoto fechou a conexão inesperadamente."

#: src/ashyterm/ui/ssh_dialogs.py:201 src/ashyterm/ui/ssh_dialogs.py:211
msgid "Connection Lost"
msgstr "Conexão Perdida"

#: src/ashyterm/ui/ssh_dialogs.py:202
msgid "The connection to the server was lost."
msgstr "A conexão com o servidor foi perdida."

#: src/ashyterm/ui/ssh_dialogs.py:207
msgid "The server closed the connection."
msgstr "O servidor fechou a conexão."

#: src/ashyterm/ui/ssh_dialogs.py:212
msgid "Failed to read from the connection. The server may have closed it."
msgstr "Falha ao ler a conexão. O servidor pode ter sido fechado."

#: src/ashyterm/ui/ssh_dialogs.py:217
msgid "Too Many Authentication Failures"
msgstr "Muitas falhas de autenticação"

#: src/ashyterm/ui/ssh_dialogs.py:218
msgid "Too many failed login attempts. Wait before trying again."
msgstr ""
"Muitas tentativas de login falharam. Aguarde antes de tentar novamente."

#: src/ashyterm/ui/ssh_dialogs.py:222
msgid "Server Disconnected"
msgstr "Servidor desconectado"

#: src/ashyterm/ui/ssh_dialogs.py:223
msgid "The server disconnected. Check server logs for details."
msgstr ""
"O servidor foi desconectado. Verifique os logs do servidor para mais "
"detalhes."

#: src/ashyterm/ui/ssh_dialogs.py:228
msgid "SSH Service Not Running"
msgstr "Serviço SSH não está em execução"

#: src/ashyterm/ui/ssh_dialogs.py:229
