msgstr ""
"Não foi possível estabelecer conexão com o servidor. Verifique se o host "
"está acessível e se a porta está correta."

#: src/ashyterm/ui/ssh_dialogs.py:49
msgid "Username or password is incorrect. Please verify your credentials."
msgstr ""
"Nome de usuário ou senha estão incorretos. Por favor, verifique suas "
"credenciais."

#: src/ashyterm/ui/ssh_dialogs.py:54
msgid "Authentication failed. Check your username and password."
msgstr "Autenticação falhou. Verifique seu nome de usuário e senha."

#: src/ashyterm/ui/ssh_dialogs.py:59 src/ashyterm/ui/ssh_dialogs.py:69
msgid "Password authentication failed. The password may be incorrect."
msgstr "A autenticação por senha falhou. A senha pode estar incorreta."

#: src/ashyterm/ui/ssh_dialogs.py:64 src/ashyterm/ui/ssh_dialogs.py:74
msgid "The password entered is incorrect."
msgstr "A senha digitada está incorreta."

#: src/ashyterm/ui/ssh_dialogs.py:80
msgid "The password is invalid or incorrect."
msgstr "A senha é inválida ou incorreta."

#: src/ashyterm/ui/ssh_dialogs.py:85
msgid "Multiple Auth Methods Failed"
msgstr "Falha em múltiplos métodos de autenticação"

#: src/ashyterm/ui/ssh_dialogs.py:87
msgid ""
"Both public key and password authentication failed. Check your credentials."
msgstr ""
"A autenticação por chave pública e senha falhou. Verifique suas credenciais."

#: src/ashyterm/ui/ssh_dialogs.py:92
msgid "SSH Key Rejected"
msgstr "Chave SSH rejeitada"

#: src/ashyterm/ui/ssh_dialogs.py:94
msgid ""
"The server rejected your SSH key. The key may not be authorized on the "
"server."
msgstr ""
"O servidor rejeitou sua chave SSH. A chave pode não estar autorizada no "
"servidor."

#: src/ashyterm/ui/ssh_dialogs.py:100
msgid "SSH Agent Error"
msgstr "Erro do Agente SSH"

#: src/ashyterm/ui/ssh_dialogs.py:101
msgid ""
"SSH agent refused the operation. Check if your key is loaded with ssh-add."
msgstr ""
"O agente SSH recusou a operação. Verifique se sua chave está carregada com "
"ssh-add."

#: src/ashyterm/ui/ssh_dialogs.py:105
msgid "SSH Agent Not Running"
msgstr "Agente SSH não está em execução"

#: src/ashyterm/ui/ssh_dialogs.py:107
msgid ""
"SSH agent is not running. Start it with eval $(ssh-agent) and add your key."
msgstr ""
"O agente SSH não está em execução. Inicie-o com eval $(ssh-agent) e adicione"
" sua chave."

#: src/ashyterm/ui/ssh_dialogs.py:115
msgid ""
"The server's host key has changed or is not trusted. This could indicate a "
"security issue."
msgstr ""
"A chave do host do servidor foi alterada ou não é confiável. Isso pode "
"indicar um problema de segurança."

#: src/ashyterm/ui/ssh_dialogs.py:120 src/ashyterm/ui/ssh_dialogs.py:127
msgid "Host Key Changed"
msgstr "A chave do host foi alterada"

#: src/ashyterm/ui/ssh_dialogs.py:122
msgid ""
"The server's host key has changed. Remove the old key from known_hosts if "
"this is expected."
msgstr ""
"A chave do host do servidor foi alterada. Remova a chave antiga de "
"known_hosts se isso for esperado."

#: src/ashyterm/ui/ssh_dialogs.py:129
msgid ""
"The server's identification has changed. This could indicate a security "
"issue or server reinstall."
msgstr ""
"A identificação do servidor foi alterada. Isso pode indicar um problema de "
"segurança ou uma reinstalação do servidor."

